                            { name: 'NAERYS SANTAGAR', done: false },
                            { name: 'SANSA STARK', done: false },
                            { name: 'STANNIS BARATHEON', done: false },
                            { name: 'JEYNE BARATHEON', done: false },
                            { name: 'RHAENYS TARGARYEN', done: false }
                        ]
                    },
                    'ep7': {
                        title: 'Ep.7. Сталь, кровь и пепел: Плач над камнем',
                        meta: 'конец 3 месяца 302 З.Э.',
                        players: [
                            { name: 'WILLAS TYRELL', done: false },
                            { name: 'MORNA ROYCE', done: false },
                            { name: 'RENLY BARATHEON', done: false },
                            { name: 'ELINOR TYRELL', done: false },
                            { name: 'ARYA STARK', done: false }
                        ]
                    },
                    'ep8': {
                        title: 'Ep.8. Сталь, кровь и пепел: Шепот в ночи',
                        meta: 'конец 3 месяца 302 З.Э.',
                        players: [
                            { name: 'DAEMON BLACKFYRE', done: false },
                            { name: 'ALYSSA VELARYON', done: false },
                            { name: 'RHAENYS TARGARYEN', done: false },
                            { name: 'LIVEN MARTELL', done: false },
                            { name: 'TRISTON HIGHTOWER', done: false },
                            { name: 'ROS', done: false },
                            { name: 'AELYX CELTIGAR', done: false }
                        ]
                    }
                }
            };
        }

        function saveToFirebase() {
            if (!fullData) return;
            database.ref(STATE_KEY).set(fullData).catch((error) => {
                console.error('Ошибка сохранения:', error);
            });
        }

        function loadFromFirebase() {
            database.ref(STATE_KEY).once('value').then((snapshot) => {
                const val = snapshot.val();
                if (val) {
                    fullData = val;
                    if (!fullData.episodes) fullData.episodes = {};
                    if (!fullData.currentEpisode) {
                        const keys = Object.keys(fullData.episodes);
                        fullData.currentEpisode = keys.length > 0 ? keys[0] : null;
                    }
                    showContent(true);
                    renderAll();
                } else {
                    showContent(false);
                }
                loadingOverlay.classList.remove('visible');
            }).catch((error) => {
                console.error('Ошибка загрузки:', error);
                loadingOverlay.classList.remove('visible');
                showContent(false);
            });
        }

        function showContent(hasData) {
            if (hasData) {
                initArea.style.display = 'none';
                contentArea.style.display = 'block';
            } else {
                initArea.style.display = 'block';
                contentArea.style.display = 'none';
                episodeSelect.innerHTML = '<option value="">— Нет данных —</option>';
            }
        }

        function renderEpisodeSelect() {
            if (!fullData) return;
            const current = fullData.currentEpisode;
            const keys = Object.keys(fullData.episodes);
            
            episodeSelect.innerHTML = '';
            if (keys.length === 0) {
                const opt = document.createElement('option');
                opt.value = '';
                opt.textContent = '— Нет эпизодов —';
                episodeSelect.appendChild(opt);
                return;
            }

            keys.forEach(key => {
                const opt = document.createElement('option');
                opt.value = key;
                const ep = fullData.episodes[key];
                opt.textContent = ep.title || key;
                if (key === current) opt.selected = true;
                episodeSelect.appendChild(opt);
            });

            if (current && keys.includes(current)) {
                episodeSelect.value = current;
            } else if (keys.length > 0) {
                episodeSelect.value = keys[0];
                fullData.currentEpisode = keys[0];
            }
        }

        function getCurrentEpisode() {
            if (!fullData) return null;
            const id = episodeSelect.value;
            if (!id || !fullData.episodes[id]) return null;
            return { id, data: fullData.episodes[id] };
        }

        function renderAll() {
            if (!fullData) return;
            
            renderEpisodeSelect();
            const ep = getCurrentEpisode();
            
            if (!ep) {
                episodeTitleEl.value = '';
                episodeMetaEl.value = '';
                queueList.innerHTML = '<li class="empty-msg">Нет эпизодов. Создайте новый.</li>';
                counterDisplay.textContent = '0 участников';
                doneBadge.textContent = '0 / 0';
                finishBtn.classList.remove('active');
                finishBtn.textContent = 'Нет эпизодов';
                return;
            }

            const data = ep.data;
            episodeTitleEl.value = data.title || '';
            episodeMetaEl.value = data.meta || '';

            const players = data.players || [];
            const total = players.length;
            const doneCount = players.filter(p => p.done).length;
            const allDone = total > 0 && doneCount === total;

            counterDisplay.textContent = `${total} участников`;
            doneBadge.textContent = `${doneCount} / ${total}`;

            let nextIndex = -1;
            for (let i = 0; i < total; i++) {
                if (!players[i].done) {
                    nextIndex = i;
                    break;
                }
            }

            queueList.innerHTML = '';
            if (total === 0) {
                const empty = document.createElement('li');
                empty.className = 'empty-msg';
                empty.textContent = 'Очередь пуста. Добавьте участников.';
                queueList.appendChild(empty);
            } else {
                players.forEach((p, idx) => {
                    const li = document.createElement('li');
                    li.className = 'queue-item';

                    if (p.done) {
                        li.classList.add('done');
                    } else if (idx === nextIndex) {
                        li.classList.add('next');
                    }

                    const indexSpan = document.createElement('span');
                    indexSpan.className = 'index';
                    indexSpan.textContent = `#${idx + 1}`;
                    li.appendChild(indexSpan);

                    const nameSpan = document.createElement('span');
                    nameSpan.className = 'name';
                    nameSpan.textContent = p.name || '?';
                    li.appendChild(nameSpan);

                    // ПРОСТОЙ ЧЕКБОКС — БЕЗ КАСТОМНЫХ СТИЛЕЙ
                    const cb = document.createElement('input');
                    cb.type = 'checkbox';
                    cb.checked = p.done;
                    cb.style.width = '20px';
                    cb.style.height = '20px';
                    cb.style.cursor = 'pointer';
                    cb.style.flexShrink = '0';
    cb.style.accentColor = '#6a8a6a';
                    cb.style.opacity = '1';
                    cb.style.visibility = 'visible';
                    cb.style.display = 'inline-block';
                    cb.style.position = 'relative';
                    cb.style.transform = 'none';
                    
                    cb.addEventListener('change', function(e) {
                        e.stopPropagation();
                        p.done = cb.checked;
                        saveToFirebase();
                        renderAll();
                    });
                    li.appendChild(cb);

                    const delBtn = document.createElement('button');
                    delBtn.className = 'delete-btn';
                    delBtn.textContent = '✕';
                    delBtn.addEventListener('click', function(e) {
                        e.stopPropagation();
                        if (confirm(`Удалить "${p.name}"?`)) {
                            data.players.splice(idx, 1);
                            saveToFirebase();
                            renderAll();
                        }
                    });
                    li.appendChild(delBtn);

                    queueList.appendChild(li);
                });
            }

            if (total > 0 && allDone) {
                finishBtn.classList.add('active');
                finishBtn.textContent = 'Завершить круг';
            } else {
                finishBtn.classList.remove('active');
                if (total === 0) {
                    finishBtn.textContent = 'Нет участников';
                } else {
                    finishBtn.textContent = `${total - doneCount} осталось`;
                }
            }
        }

        function initDefaultData() {
            fullData = getDefaultData();
            saveToFirebase();
            showContent(true);
            renderAll();
        }

        initBtn.addEventListener('click', initDefaultData);

        episodeTitleEl.addEventListener('input', function() {
            if (!fullData) return;
            const id = episodeSelect.value;
            if (id && fullData.episodes[id]) {
                fullData.episodes[id].title = episodeTitleEl.value;
                saveToFirebase();
                renderEpisodeSelect();
            }
        });

        episodeMetaEl.addEventListener('input', function() {
            if (!fullData) return;
            const id = episodeSelect.value;
            if (id && fullData.episodes[id]) {
                fullData.episodes[id].meta = episodeMetaEl.value;
                saveToFirebase();
            }
        });

        episodeSelect.addEventListener('change', function() {
            if (!fullData) return;
            fullData.currentEpisode = episodeSelect.value;
            saveToFirebase();
            renderAll();
        });

        function addPlayer() {
            const raw = newNameInput.value.trim();
            if (!raw) {
                alert('Введите имя персонажа.');
                return;
            }
            const ep = getCurrentEpisode();
            if (!ep) {
                alert('Нет активного эпизода.');
                return;
            }
            ep.data.players.push({ name: raw, done: false });
            saveToFirebase();
            renderAll();
            newNameInput.value = '';
            newNameInput.focus();
        }

        addBtn.addEventListener('click', addPlayer);
        newNameInput.addEventListener('keydown', function(e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                addPlayer();
            }
        });

        finishBtn.addEventListener('click', function() {
            const ep = getCurrentEpisode();
            if (!ep) return;
            const players = ep.data.players;
            const total = players.length;
            if (total === 0) return;
            const doneCount = players.filter(p => p.done).length;
            if (doneCount !== total) {
                alert('Не все отписались!');
                return;
            }
            for (let p of players) {
                p.done = false;
            }
            saveToFirebase();
            renderAll();
        });

        function openModal() {
            newEpisodeTitle.value = '';
            newEpisodeMeta.value = '';
            modalOverlay.classList.add('visible');
            setTimeout(() => newEpisodeTitle.focus(), 100);
        }

        function closeModal() {
            modalOverlay.classList.remove('visible');
        }

        function createEpisode() {
            const title = newEpisodeTitle.value.trim() || 'Новый эпизод';
            const meta = newEpisodeMeta.value.trim() || '';
            const id = 'ep' + Date.now();
            fullData.episodes[id] = {
                title: title,
                meta: meta,
                players: []
            };
            fullData.currentEpisode = id;
            saveToFirebase();
            renderAll();
            closeModal();
        }

        addEpBtn.addEventListener('click', openModal);
        modalCancel.addEventListener('click', closeModal);
        modalConfirm.addEventListener('click', createEpisode);
        modalOverlay.addEventListener('click', function(e) {
            if (e.target === modalOverlay) closeModal();
        });
        newEpisodeTitle.addEventListener('keydown', function(e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                newEpisodeMeta.focus();
            }
        });
        newEpisodeMeta.addEventListener('keydown', function(e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                createEpisode();
            }
        });

        deleteEpBtn.addEventListener('click', function() {
            if (!fullData) return;
            const id = episodeSelect.value;
            if (!id || !fullData.episodes[id]) return;
            if (!confirm(`Удалить эпизод "${fullData.episodes[id].title}"?`)) return;
            
            delete fullData.episodes[id];
            const keys = Object.keys(fullData.episodes);
            if (keys.length > 0) {
                fullData.currentEpisode = keys[0];
            } else {
                fullData.currentEpisode = null;
            }
            saveToFirebase();
            renderAll();
        });

        loadFromFirebase();
    })();
</script>

</body>
</html>
